{
  "manifest_version": 3,
  "name": "Pookye Download Manager",
  "version": "0.1.0",
  "description": "Hands your browser's downloads to Pookye Download Manager, which fetches them over several connections at once.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Pookye Download Manager",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "permissions": ["downloads", "contextMenus", "storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js"
  },
  "minimum_chrome_version": "116"
}
