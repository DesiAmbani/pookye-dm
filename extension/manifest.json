{
  "manifest_version": 3,
  "name": "Pookye Download Manager",
  "version": "0.1.0",
  "description": "Hands your browser's downloads to Pookye Download Manager, which fetches them over several connections at once.",
  "action": {
    "default_title": "Pookye Download Manager",
    "default_popup": "popup.html"
  },
  "permissions": ["downloads", "contextMenus", "storage", "cookies"],
  "host_permissions": ["http://127.0.0.1/*", "http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "minimum_chrome_version": "116"
}
